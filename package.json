{
  "name": "joggle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opinionated cross-file idiom rules for TypeScript — a layer above the linter and the typechecker.",
  "license": "MIT",
  "exports": {
    "./plugin": "./src/plugin.ts",
    "./testing": "./src/testing.ts",
    "./presets/composition": "./src/presets/composition.ts"
  },
  "bin": {
    "joggle": "./bin/joggle.js"
  },
  "scripts": {
    "joggle": "node src/main.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "lint": "node scripts/lint-baseline.mjs",
    "lint:update": "node scripts/lint-baseline.mjs --update",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115",
    "oxc-parser": "^0.150.0"
  },
  "devDependencies": {
    "@autotelic/plumb": "^0.6.0",
    "@effect/vitest": "4.0.0-rc.115",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxlint": "^1.83.0",
    "vitest": "^5.0.1"
  }
}